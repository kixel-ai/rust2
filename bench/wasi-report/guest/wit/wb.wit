package rust2:wb;

interface callback {
	/// A closure the host implements, lent for a call.
	resource visit {
		call: func() -> u64;
	}
}

interface api {
	use callback.{visit};

	/// Two counts copied across.
	record span {
		start: u64,
		end: u64,
	}

	/// A new object per call.
	resource info {
		priority: func() -> s8;
	}

	/// One handle each case borrows.
	resource track {
		constructor();
		is-closed: func() -> bool;
		start: func() -> u64;
		largest: func() -> option<span>;
		info: func() -> info;
		write: func(frame: list<u8>);
		payload: func() -> list<u8>;
		big: func(len: u32) -> list<u8>;
	}

	noop: func();
	visit-with: func(f: borrow<visit>) -> u64;
	boom: func();
}

interface reads {
	use api.{track};
	/// A read ready at its first poll.
	read: async func(track: borrow<track>) -> u64;
}

world sync {
	import callback;
	export api;
}

world full {
	import callback;
	export api;
	export reads;
}
