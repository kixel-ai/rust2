#!/usr/bin/env just --justfile
#
# The driver front end, invoked from the repo root as `just driver <recipe>`.
# Its own workspace on ts/rust-toolchain.toml's nightly, which the dev shell exports as
# RUST2_TS_TOOLCHAIN; without it, rustup reads the same file through the link here.

set shell := ["bash", "-euo", "pipefail", "-c"]

# mbx's Cargo shim, which the dev shell exports, stays ahead of the nightly so cargo still builds through it.
cargo_shim := if env("RUST2_CARGO_SHIM", "") == "" { "" } else { env("RUST2_CARGO_SHIM") + ":" }
export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { cargo_shim + env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }
clippy_driver := if env("RUST2_TS_TOOLCHAIN", "") == "" { require("clippy-driver") } else { env("RUST2_TS_TOOLCHAIN") / "bin/clippy-driver" }

default:
    @just --list

# Lint and format-check the driver front end and rust2-pub.
check:
    cargo clippy --locked --workspace --all-targets -- -D warnings
    just lint

# Everything `check` verifies besides the workspace clippy compile, which `test` enforces in one pass.
lint:
    cargo fmt --all --check

# Run the driver front end's and rust2-pub's tests, enforcing clippy from the same compile.
test *args:
    CARGO_BUILD_WARNINGS=deny RUSTC_WORKSPACE_WRAPPER={{ quote(clippy_driver) }} cargo nextest run --locked --workspace {{ args }}

# Audit which `pub` items another crate needs, from where it is invoked: `just driver pub --help`.
[no-cd]
pub *args:
    cargo run --quiet --locked --release --manifest-path {{ quote(source_directory() / "Cargo.toml") }} --package rust2-pub -- {{ args }}

# Translate a crate's pure subset to Lean 4, from where it is invoked: `just driver lean --help`.
[no-cd]
lean *args:
    cargo run --quiet --locked --release --manifest-path {{ quote(source_directory() / "Cargo.toml") }} --package rust2-lean -- {{ args }}

# Translate kio's pure machines with rust2-lean, prove Ranked.lean, and diff against native Rust; needs `nix develop .#lean`.
lean-kio *args:
    lean/compare/kio.sh {{ args }}

# Translate the fixture's cases with rust2-lean, and diff them against native Rust; needs `nix develop .#lean`.
lean-fixture *args:
    lean/compare/fixture.sh {{ args }}

# Translate moq-net's route algebra with rust2-lean, and diff it against native Rust; needs `nix develop .#lean`.
lean-moq *args:
    lean/compare/moq.sh {{ args }}

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --workspace --all-targets
    cargo fmt --all

