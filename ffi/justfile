# Run moq/moq.ts through the Node binding's addon on Node, Deno, and Bun: the React Native binding's script, whose binding the Node one shares its API with.
[private]
moq-node-run:
    #!/usr/bin/env bash
    set -euo pipefail
    src=target/moq-node-src
    mkdir -p "$src"
    sed -e 's|"\./react-native/|"./node/|' moq/moq.ts > "$src/moq.ts"
