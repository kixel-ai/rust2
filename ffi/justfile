#!/usr/bin/env just --justfile
#
# The C exporter, invoked from the repo root as `just ffi <recipe>`. Its crates are their
# own workspace on ts/rust-toolchain.toml's nightly, which the dev shell exports as
# RUST2_TS_TOOLCHAIN; without it, rustup reads the same file through the link here.

set shell := ["bash", "-euo", "pipefail", "-c"]

# mbx's Cargo shim, which the dev shell exports, stays ahead of the nightly so cargo still builds through it.
cargo_shim := if env("RUST2_CARGO_SHIM", "") == "" { "" } else { env("RUST2_CARGO_SHIM") + ":" }
export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { cargo_shim + env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }

# The moq revision these recipes export by default: `just ts`'s, so both follow one moq.
# just's own path is quoted wherever bash runs it: on Windows, its backslashes are escapes.
moq_rev := shell(quote(just_executable()) + " --justfile ../ts/justfile --evaluate moq_rev")

# swift-collections 1.7.5, whose `UniqueArray` the generated Swift imports.
swift_collections_rev := "f96b909e1a9e469620bc5037c1e24e00153f376f"

default:
    @just --list

# Lint and format-check the exporter and its fixtures.
check:
    cargo clippy --locked --all-targets -- -D warnings
    cargo fmt --all --check
    cargo shear
    cargo sort --workspace --check --no-format

# Export each fixture, build it, and run its C test.
test *args:
    cargo test --locked {{ args }}

# Round-trip every sampled type shape in every language, as the nightly does; the gate runs a subset.
shapes:
    cargo test --locked --test fixtures shapes::nightly -- --ignored

# Shrink the api fixture's Kotlin with R8 and its generated rules, and run its test on the Android device adb reaches, in the Android shell (nix develop .#android) with ANDROID_HOME and ANDROID_NDK_HOME set.
android:
    cargo test --locked --test fixtures -- --ignored --exact api_android

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --all-targets
    cargo fmt --all
    cargo shear --fix
    cargo sort --workspace --no-format

# Run the exporter: `just ffi run --config <ffi.toml> --out <dir>`.
run *args:
    cargo run --locked --quiet -- {{ args }}

# Census the stand-in facade moq/ffi.toml exports into target/census/moq-ffi.md, from the pinned moq revision or a checkout.
census checkout="": (standin checkout)
    cargo run --locked --quiet -- --config moq/ffi.toml --manifest-path target/moq-ffi/Cargo.toml --census target/census

# Measure the binding benchmark (bench/ffi/README.md) from the pinned moq revision or a checkout, in the bench shell: nix develop .#bench. Its tables go to target/bench/report.md.
bench checkout="": (bench-build checkout) bench-run

# Build the binding benchmark's programs: Rust's floor, C, C++, Kotlin, Python, Swift, Go, and Dart through the export, and C through moq's hand-written rs/moq-c.
bench-build checkout="": (moq-export checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    [ -n "${LIBCLANG_PATH:-}" ] || { echo "LIBCLANG_PATH is unset: run this in the bench shell, nix develop .#bench" >&2; exit 1; }
    src="{{ checkout }}"
    [ -n "$src" ] || src=target/moq
    out=target/export/moq
    # The floor: the stand-in's API called from Rust, resolved as the export is.
    rm -rf target/bench-rust
    mkdir -p target/bench-rust
    printf '[package]\nname = "bench"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n\n[[bin]]\nname = "bench"\npath = "%s"\n\n[dependencies]\nlibc = "0.2"\nmoq = { package = "moq-ffi", path = "../moq-ffi" }\n\n[workspace]\n' "$PWD/moq/bench/export.rs" > target/bench-rust/Cargo.toml
    cp target/moq-ffi/Cargo.lock target/bench-rust/Cargo.lock
    cargo build --quiet --release --manifest-path target/bench-rust/Cargo.toml
    # moq-c's header is written to its build script's output directory.
    moqc=$(cd "$src" && cargo build --locked --quiet --release --package moq-c --message-format=json \
        | jq -r 'select(.reason == "build-script-executed" and (.package_id | contains("moq-c#"))) | .out_dir')
    cc -O2 -std=c11 -Wall -Wextra -Werror -I "$out/include" moq/bench/export.c "$out/target/release/libmoq.a" -lpthread -ldl -lm -o target/bench-export
    cc -O2 -std=c11 -Wall -Wextra -Werror -I "$moqc/include" moq/bench/moq-c.c "$src/target/release/libmoq.a" -lpthread -ldl -lm -o target/bench-moq-c
    c++ -O2 -std=c++17 -Wall -Wextra -Werror -I "$out/include" moq/bench/export.cpp "$out/target/release/libmoq.a" -lpthread -ldl -lm -o target/bench-export-cpp
    {{ quote(just_executable()) }} go-module bench-go moq/bench/export.go
    read -ra native < target/moq-native
    export CGO_LDFLAGS="$PWD/$out/target/release/libmoq.a ${native[*]}" GOFLAGS=-buildvcs=false
    (cd target/bench-go && go build -o bench .)
    {{ quote(just_executable()) }} dart-program bench-dart moq/bench/export.dart
    rm -rf target/bench-kt
    kotlinc -Werror -cp "$KOTLINX_COROUTINES" "$out/kotlin/moq.kt" moq/bench/export.kt -d target/bench-kt
    {{ quote(just_executable()) }} swift-module -O
    swiftc -O -warnings-as-errors $({{ quote(just_executable()) }} swift-target 15) -I target/swift -I target/swift-collections/build -I "$out/swift" moq/bench/export.swift target/swift/libMoq.a -L target/swift-collections/build -lBasicContainers -lInternalCollectionsUtilities -lSpanPreview "$out/target/release/libmoq.a" -lpthread -ldl -lm -o target/bench-export-swift

# Run what bench-build built: each program `rounds` times into target/bench/raw.tsv, with the 1-minute load average over each run, and their medians and the export's sizes into target/bench/report.md.
bench-run rounds="3":
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    mkdir -p target/bench
    raw=target/bench/raw.tsv
    : > "$raw"
    # Each program prints a case, its wall time, and its CPU time a line; this prefixes its
    # language and round, and suffixes the load average over the run, the mean of the
    # 1-minute averages before and after it.
    load() {
        if [ "{{ os() }}" = macos ]; then
            sysctl -n vm.loadavg | awk '{ print $2 }'
        else
            awk '{ print $1 }' /proc/loadavg
        fi
    }
    run() {
        local lang=$1 before after
        shift
        before=$(load)
        "$@" > target/bench/run.tsv
        after=$(load)
        awk -v lang="$lang" -v round="$r" -v loadavg="$(echo "$before $after" | awk '{ print ($1 + $2) / 2 }')" -F '\t' \
            'NF == 3 { print lang "\t" round "\t" $1 "\t" $2 "\t" $3 "\t" loadavg; next } { print "bench: " lang ": unexpected line: " $0 > "/dev/stderr"; exit 1 }' \
            target/bench/run.tsv >> "$raw"
    }
    for r in $(seq {{ rounds }}); do
        run rust target/bench-rust/target/release/bench
        run c target/bench-export
        run cpp target/bench-export-cpp
        run moq-c target/bench-moq-c
        run kotlin kotlin -Djava.library.path="$out/target/release" -cp "target/bench-kt:$KOTLINX_COROUTINES" ExportKt
        PYTHONPATH="$out/python" run python python3 -P moq/bench/export.py
        run swift target/bench-export-swift
        run go target/bench-go/bench
        run dart dart target/bench-dart/main.dill
    done
    python3 -I ../bench/ffi/report.py "$raw" "$out" > target/bench/report.md
    cat target/bench/report.md

# Export moq's crates' C ABI, build it, and run moq/moq.c, moq/moq.cpp, moq/moq.kt, moq/moq.py, moq/moq.swift, moq/moq.go, and moq/moq.dart against it, from the pinned moq revision or a checkout.
moq checkout="": (moq-cpp checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    read -ra native < target/moq-native
    cc -std=c11 -pedantic -Wall -Wextra -Werror -I "$out/include" moq/moq.c "$out/target/release/libmoq.a" "${native[@]}" -o target/moq-test
    target/moq-test
    # The Kotlin, on the JVM, through the JNI functions the kotlin feature builds.
    rm -rf target/moq-kt
    kotlinc -Werror -cp "$KOTLINX_COROUTINES" "$out/kotlin/moq.kt" moq/moq.kt -d target/moq-kt
    kotlin -Djava.library.path="$out/target/release" -cp "target/moq-kt:$KOTLINX_COROUTINES" MoqKt
    # The Python, through the CPython extension the python feature builds, and its types
    # through mypy and pyright, as `api_py_types` checks the api fixture's.
    PYTHONPATH="$out/python" python3 -P -X dev -W error moq/moq.py
    mypy --strict --python-version 3.11 --cache-dir target/mypy "$out/python/moq.py"
    pyright -p tests/pyright.json "$out/python/moq.py"
    {{ quote(just_executable()) }} moq-swift-run
    # The Go, through cgo, linking the library and what it needs besides.
    {{ quote(just_executable()) }} go-module moq-go moq/moq.go
    export CGO_LDFLAGS="$PWD/$out/target/release/libmoq.a ${native[*]}" GOFLAGS=-buildvcs=false
    (cd target/moq-go/export && go vet ./...)
    (cd target/moq-go && go vet ./... && go run .)
    # The Dart, through the shared library the dart feature builds.
    {{ quote(just_executable()) }} dart-program moq-dart moq/moq.dart
    dart --enable-asserts target/moq-dart/main.dill

# Export and build moq's crates' C ABI as `just ffi moq` does, and run only moq/moq.cpp against it, built by $CXX or the platform's compiler: MSVC's on Windows, from a developer environment.
moq-cpp checkout="": (moq-export checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    read -ra native < target/moq-native
    # The C++ header at OBS's standard, without exceptions or RTTI.
    if [ "{{ os_family() }}" = windows ]; then
        # Git Bash would read a flag that starts with a slash, such as rustc's /defaultlib, as a path.
        MSYS2_ARG_CONV_EXCL='*' cl -nologo -std:c++17 -permissive- -W4 -WX -MD -EHs-c- -D_HAS_EXCEPTIONS=0 -GR- -I "$out/include" moq/moq.cpp -Fotarget/moq-cpp-test.obj -Fetarget/moq-cpp-test.exe -link "$out/target/release/moq.lib" "${native[@]}"
    else
        # -Wshadow stands in for MSVC's warnings that a name hides another.
        "${CXX:-c++}" -std=c++17 -fno-exceptions -fno-rtti -pedantic -Wall -Wextra -Wshadow -Werror -I "$out/include" moq/moq.cpp "$out/target/release/libmoq.a" "${native[@]}" -o target/moq-cpp-test
    fi
    target/moq-cpp-test

# Export and build moq's crates' C ABI as `just ffi moq` does, and run only moq/moq.swift against it, through Swift on PATH: Apple's on macOS.
moq-swift checkout="": (moq-export checkout) moq-swift-run

# Build the exported Swift as the module Moq, and run moq/moq.swift against it.
[private]
moq-swift-run:
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    read -ra native < target/moq-native
    {{ quote(just_executable()) }} swift-module
    swiftc -warnings-as-errors $({{ quote(just_executable()) }} swift-target 15) -parse-as-library -I target/swift -I target/swift-collections/build -I "$out/swift" moq/moq.swift target/swift/libMoq.a -L target/swift-collections/build -lBasicContainers -lInternalCollectionsUtilities -lSpanPreview "$out/target/release/libmoq.a" "${native[@]}" -o target/moq-swift-test
    target/moq-swift-test

# Build target/export/moq's Swift as the module Moq in target/swift, at Swift 6's language mode. Its deployment target is the oldest its `Swift.Duration` allows.
[private]
swift-module *flags: swift-collections
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq/swift
    rm -rf target/swift
    mkdir -p target/swift
    swiftc -warnings-as-errors $({{ quote(just_executable()) }} swift-target 13) -swift-version 6 {{ flags }} -parse-as-library -module-name Moq -emit-module -emit-module-path target/swift/Moq.swiftmodule -emit-library -static -I "$out" -I target/swift-collections/build "$out/moq.swift" -o target/swift/libMoq.a

# Build swift-collections' BasicContainers, which the generated Swift imports, and the modules it imports, at the pinned revision with Swift on PATH, into target/swift-collections/build: a module and a static library each, as its package's manifest for Swift 6.2 builds them.
[private]
swift-collections:
    #!/usr/bin/env bash
    set -euo pipefail
    src=target/swift-collections/src
    out=target/swift-collections/build
    [ -d "$src/.git" ] || git clone --quiet --filter=blob:none --no-checkout https://github.com/apple/swift-collections "$src"
    GIT_NO_LAZY_FETCH=1 git -C "$src" cat-file -e {{ swift_collections_rev }}^{commit} 2> /dev/null || git -C "$src" fetch --quiet origin {{ swift_collections_rev }}
    git -C "$src" checkout --quiet --detach {{ swift_collections_rev }}
    # Built once for each revision and compiler.
    stamp="{{ swift_collections_rev }} $(swiftc --version 2>&1)"
    [ "$(cat "$out/stamp" 2> /dev/null)" != "$stamp" ] || exit 0
    rm -rf "$out"
    mkdir -p "$out"
    flags=(-swift-version 6 -O -parse-as-library -package-name swift_collections -I "$out" $({{ quote(just_executable()) }} swift-target 13)
        -enable-upcoming-feature MemberImportVisibility -enable-experimental-feature BuiltinModule
        -enable-experimental-feature Lifetimes -enable-experimental-feature InoutLifetimeDependence
        -enable-experimental-feature AddressableParameters -enable-experimental-feature AddressableTypes)
    while IFS= read -r macro; do
        flags+=(-enable-experimental-feature "AvailabilityMacro=$macro")
    done < <(sed -nE 's/^ *"(SwiftStdlib [0-9.]+)": *"([^"]+)",?$/\1: \2/p' "$src/Package@swift-6.2.swift")
    for module in InternalCollectionsUtilities SpanPreview BasicContainers; do
        files=()
        while IFS= read -r -d '' file; do files+=("$file"); done < <(find "$src/Sources/$module" -name '*.swift' -print0 | sort -z)
        swiftc "${flags[@]}" -module-name "$module" -emit-module -emit-module-path "$out/$module.swiftmodule" -emit-library -static -o "$out/lib$module.a" "${files[@]}"
    done
    echo "$stamp" > "$out/stamp"

# swiftc's target at this macOS deployment target on macOS, and nothing elsewhere.
[private]
swift-target macos:
    #!/usr/bin/env bash
    if [ "{{ os() }}" = macos ]; then echo "-target $(uname -m)-apple-macos{{ macos }}"; fi

# Lay out target/<dir> as a Go module whose main package is <main>, requiring the export's module of a package per crate in export/, beside the header it includes, linking the library through cgo.
[private]
go-module dir main:
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    dir=target/{{ dir }}
    rm -rf "$dir"
    mkdir -p "$dir/include"
    cp -r "$out/go" "$dir/export"
    cp "$out/include/moq.h" "$dir/include/"
    cp {{ main }} "$dir/main.go"
    printf 'module moqtest\n\ngo 1.24\n\nrequire moq v0.0.0\n\nreplace moq => ./export\n' > "$dir/go.mod"

# Lay out target/<dir> as a Dart program whose main is <main>, importing the export's Dart as package:moq/moq.dart, whose native asset is the shared library, as a package's build hook would bundle it, which `dart compile` has no flag for; analyze it, and compile it into target/<dir>/main.dill.
[private]
dart-program dir main:
    #!/usr/bin/env bash
    set -euo pipefail
    out=$PWD/target/export/moq
    dir=target/{{ dir }}
    rm -rf "$dir"
    mkdir -p "$dir/.dart_tool"
    cp {{ main }} "$dir/main.dart"
    case "{{ os() }}" in
        macos) lib=libmoq.dylib ;;
        *) lib=libmoq.so ;;
    esac
    case "{{ arch() }}" in
        aarch64) arch=arm64 ;;
        *) arch=x64 ;;
    esac
    printf '{"configVersion": 2, "packages": [{"name": "moq", "rootUri": "file://%s/dart/", "packageUri": "./"}]}\n' "$out" > "$dir/.dart_tool/package_config.json"
    printf 'format-version: [1, 0, 0]\nnative-assets:\n  %s_%s:\n    "package:moq/moq.dart": [absolute, "%s"]\n' "{{ os() }}" "$arch" "$out/target/release/$lib" > "$dir/native_assets.yaml"
    dart analyze --fatal-infos "$dir"
    sdk=$(dirname "$(dirname "$(realpath "$(command -v dart)")")")
    "$sdk/bin/dartaotruntime" "$sdk/bin/snapshots/gen_kernel_aot.dart.snapshot" --platform "$sdk/lib/_internal/vm_platform_strong.dill" \
        --packages "$dir/.dart_tool/package_config.json" --native-assets "$dir/native_assets.yaml" -o "$dir/main.dill" "$dir/main.dart"

# Export moq's crates' C ABI into target/export/moq and build it, with the libraries a program linking it needs besides in target/moq-native.
[private]
moq-export checkout="": (standin checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    cargo run --locked --quiet -- --config moq/ffi.toml --manifest-path target/moq-ffi/Cargo.toml --out "$out"
    # A later nightly makes this future-compat lint a hard error; fail on it in moq's crates
    # and the glue now, while the pin can still move. rustc prints the native libraries.
    export RUSTFLAGS="-D recursion_depth_exceeding_limit --print=native-static-libs"
    # The CPython extension's symbols would leave the C programs' links undefined, so it
    # builds apart, before the library they link, and moves beside the Python.
    case "{{ os() }}" in
        windows) lib=moq.dll ;;
        macos) lib=libmoq.dylib ;;
        *) lib=libmoq.so ;;
    esac
    cargo build --locked --quiet --release --manifest-path "$out/Cargo.toml" --features python
    mv "$out/target/release/$lib" "$out/python/$lib"
    # The library the C programs link, and the shared one Kotlin and Dart load.
    cargo build --locked --quiet --release --manifest-path "$out/Cargo.toml" --features kotlin,dart 2>&1 | tee target/moq-build.log
    sed -n 's/^note: native-static-libs: //p' target/moq-build.log > target/moq-native

# Write target/moq-ffi, a facade re-exporting what moq-ffi ships from moq's crates, from the pinned moq revision or a checkout: the export follows its re-exports, as it will moq-ffi's remainder's.
[private]
standin checkout="":
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{ checkout }}"
    if [ -z "$src" ]; then
        {{ quote(just_executable()) }} moq-pin
        src=target/moq
    fi
    src=$(realpath "$src")
    # Cargo on Windows reads a path as Windows writes it, not as Git Bash does.
    if [ "{{ os_family() }}" = windows ]; then
        src=$(cygpath -m "$src")
    fi
    dir=target/moq-ffi
    # moq-ffi's dependencies, moq-tokio with its default features as moq-ffi has them.
    deps=(hang kio moq-mux moq-net moq-pattern moq-tokio)
    mkdir -p "$dir/src"
    {
        printf '# Generated by just ffi standin, from %s.\n' "$src"
        printf '[package]\nname = "moq-ffi"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n\n'
        # The prefix of every C name.
        printf '[lib]\nname = "moq"\n\n[dependencies]\n'
        for name in "${deps[@]}"; do
            printf '%s = { path = "%s/rs/%s" }\n' "$name" "$src" "$name"
        done
        printf '\n[workspace]\n'
    } > "$dir/Cargo.toml"
    # What moq-ffi ships, re-exported: moq-net and moq-pattern at the root, beside the
    # waiter a driver's poll registers and the clock it polls at, and each other crate in a
    # module of its own, since several name an item alike, such as `Error`. moq-tokio's
    # session side only: the client, server, and origin a binding drives, with the configs
    # and the bind they take. Its QUIC driver, CLI, worker groups, and listener internals
    # stay out.
    cat > "$dir/src/lib.rs" <<'EOF'
    pub use kio::{Park, Waiter, WaiterList, clock, coop, log};
    pub use moq_net::*;
    pub use moq_pattern::*;

    pub mod hang {
        pub use ::hang::*;
    }

    pub mod mux {
        pub use ::moq_mux::*;
    }

    pub mod tokio {
        pub use ::moq_tokio::cli::Duration;
        pub use ::moq_tokio::{Backoff, Client, ConnectError, Connection, Error, Log, Restart, Server, Status, Transport, tls};

        pub mod client {
            pub use ::moq_tokio::client::Config;
        }

        pub mod connect {
            pub use ::moq_tokio::connect::Config;
        }

        pub mod connection {
            pub use ::moq_tokio::connection::Monitor;
        }

        pub mod listen {
            pub use ::moq_tokio::listen::{Bind, Config};
        }

        pub mod origin {
            pub use ::moq_tokio::origin::spawn;
        }

        pub mod quic {
            pub use ::moq_tokio::quic::Config;
        }

        pub mod server {
            pub use ::moq_tokio::server::{Config, Listener, Request};
        }
    }
    EOF
    # moq's lockfile pins what moq's own builds use.
    cp "$src/Cargo.lock" "$dir/Cargo.lock"

# Check out the pinned moq revision in target/moq, apart from `just ts`'s so neither recipe touches the other's checkout, copying the objects its clone already has.
[private]
moq-pin:
    [ -d target/moq/.git ] || git clone --quiet --filter=blob:none --reference-if-able ../ts/target/moq --dissociate https://github.com/moq-dev/moq target/moq
    GIT_NO_LAZY_FETCH=1 git -C target/moq cat-file -e {{ moq_rev }}^{commit} 2> /dev/null || git -C target/moq fetch --quiet origin {{ moq_rev }}
    git -C target/moq checkout --quiet --detach {{ moq_rev }}
