#!/usr/bin/env just --justfile
#
# The C exporter, invoked from the repo root as `just ffi <recipe>`. Its crates are their
# own workspace on ts/rust-toolchain.toml's nightly, which the dev shell exports as
# RUST2_TS_TOOLCHAIN; without it, rustup reads the same file through the link here.

set shell := ["bash", "-euo", "pipefail", "-c"]

# mbx's Cargo shim, which the dev shell exports, stays ahead of the nightly so cargo still builds through it.
cargo_shim := if env("RUST2_CARGO_SHIM", "") == "" { "" } else { env("RUST2_CARGO_SHIM") + ":" }
export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { cargo_shim + env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }

# The exporter. Under mbx's shim, it runs without the $CARGO `cargo run` hands it, which names
# the cargo the shim chains to, so its checks would compile every crate with no cache. The
# shim comes only with the dev shell, whose `env` keeps the library paths cargo sets for the
# nightly's rustc_driver, which macOS's /usr/bin/env would drop.
exporter := if cargo_shim == "" { "cargo run --locked --quiet --" } else { "cargo run --locked --quiet --config \"target.'cfg(all())'.runner=['env','-u','CARGO']\" --" }

# The moq revision these recipes export by default. It is the exporter's own pin, apart from
# the model fixture's in ts/fixtures/model/Cargo.toml, so bumping one does not wait on the other.
moq_rev := "1aa86d5e6d091848cb1848c702a911099706b1a4"

# swift-collections 1.7.5, whose `UniqueArray` the generated Swift imports.
swift_collections_rev := "f96b909e1a9e469620bc5037c1e24e00153f376f"

# The binding benchmark's programs, each a language, as bench-program runs them.
bench_langs := "rust c cpp moq-c kotlin python swift go dart csharp ts-node ts-addon ts-chromium ts-firefox react-native"

# Those whose cases count the same under Valgrind on every run of one commit: bench/ffi/README.md's Instruction counts section says why Swift, Kotlin, Go, Dart, and C# do not.
count_langs := "rust c cpp moq-c python ts-node"

default:
    @just --list

# Lint and format-check the exporter and its fixtures.
check:
    cargo clippy --locked --all-targets -- -D warnings
    cargo fmt --all --check
    cargo shear
    cargo sort --workspace --check --no-format

# Export each fixture, build it, and run its C test.
test *args:
    cargo test --locked {{ args }}

# Round-trip every sampled type shape in every language, as the nightly does; the gate runs a subset.
shapes:
    cargo test --locked --test fixtures shapes::nightly -- --ignored

# Census and export each crate of corpus/crates.txt through a facade, and build every language's binding of it, as the nightly does, with the exporter optimized, which the time spent exporting repays: CORPUS_SHARD=i/n runs a slice, CORPUS_CRATES=a,b those crates. It runs their build scripts, so run it where that is safe. The report goes to target/tmp/corpus/report.md, or a shard's directory.
corpus:
    cargo test --locked --release --test fixtures corpus::nightly -- --ignored --exact

# Take corpus/crates.txt afresh from crates.io's top crates by downloads, and resolve corpus/Cargo.lock. It builds them, as `corpus` does.
corpus-update:
    cargo test --locked --test fixtures corpus::update -- --ignored --exact

# Run longer protocol scripts from more seeds through the C ABI and every binding, as the nightly does; the gate runs fewer.
protocol:
    cargo test --locked --test fixtures protocol_nightly -- --ignored

# Write the api fixture's checks, each beside the script tests/fixtures/transcript generates, into <dir>/python, <dir>/cpp, <dir>/web, <dir>/dart, <dir>/go, and <dir>/swift, the directories the release builder's check inputs take.
transcripts dir:
    out="$(cd {{ quote(invocation_directory()) }} && mkdir -p {{ quote(dir) }} && cd {{ quote(dir) }} && pwd)" && RUST2_TRANSCRIPTS="$out" cargo test --locked --test fixtures -- --ignored --exact transcripts

# Compile the api fixture's C# ahead of time with NativeAOT and run its test, as the nightly does.
aot:
    cargo test --locked --test fixtures -- --ignored --exact api_csharp_aot

# Run the api fixture's web test in headless Chromium, Firefox, and on Linux WebKit, in the bench shell, which carries them: nix develop .#bench.
browsers:
    cargo test --locked --test fixtures -- --ignored --exact api_browsers

# Run the api fixture's script and cases through its React Native binding on Hermes off a device, the flake's, which nix builds on first use.
react-native-host:
    hermes=$(nix build --no-link --print-out-paths ..#hermes) && RUST2_HERMES="$hermes" cargo test --locked --test fixtures -- --ignored --exact api_react_native_host

# Run the api fixture's script and cases through its React Native package in a new React Native app, built for release, on the 64-bit Android device adb reaches, in the Android shell (nix develop .#android) with ANDROID_HOME and ANDROID_NDK_HOME set, Node, and the network.
react-native-android:
    cargo test --locked --test fixtures -- --ignored --exact api_react_native_android

# The same on the booted iOS simulator of the host's architecture, on macOS with Xcode, CocoaPods, and the simulator's Rust target.
react-native-ios:
    cargo test --locked --test fixtures -- --ignored --exact api_react_native_ios

# Shrink the api fixture's Kotlin with R8 and its generated rules, and run its test under CheckJNI on the Android device adb reaches, in the Android shell (nix develop .#android) with ANDROID_HOME and ANDROID_NDK_HOME set.
android:
    cargo test --locked --test fixtures -- --ignored --exact api_android

# Run the api fixture's C and C++ scripts under AddressSanitizer with UndefinedBehaviorSanitizer, ThreadSanitizer, and Valgrind, its Swift script under ThreadSanitizer, its Go script under Go's race detector and cgocheck2, its Python script looped on a debug CPython and threaded on a free-threaded one under ThreadSanitizer, and its glue's C ABI under Miri, in the sanitize shell: nix develop .#sanitize.
sanitize:
    cargo test --locked --test fixtures -- --ignored --exact api_asan api_tsan api_valgrind api_swift_tsan api_go_checked api_python_debug api_python_tsan api_miri

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --all-targets
    cargo fmt --all
    cargo shear --fix
    cargo sort --workspace --no-format

# Write src/macros.txt, the macros a C or C++ header may define, which a C or C++ name keeps apart from, from glibc's, musl's, and macOS's headers.
macros:
    src/macros.sh

# Run the exporter: `just ffi run --manifest-path <Cargo.toml> --out <dir>`.
run *args:
    {{ exporter }} {{ args }}

# Write surface/, each binding's API as its language renders it, from the api fixture's export and moq's stand-in's at the pinned moq revision: --check fails where a committed file differs instead. The files are x86_64 Linux's exports, whose targets they name.
surface *flags: (moq-write "") (standin "" "web")
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{ arch() }}-{{ os() }}" != x86_64-linux ]; then
        echo "the surface files are x86_64 Linux's exports: run this there" >&2
        exit 1
    fi
    # moq-write's export, of the host alone.
    if [ "$(jq -c .api.targets target/export/moq/api.json)" != '["x86_64-unknown-linux-gnu"]' ]; then
        echo "target/export/moq merged the APIs staged in target/moq-api: delete them for the host's export" >&2
        exit 1
    fi
    # The api fixture as its tests export it, with wasm32 for the web binding.
    {{ exporter }} --manifest-path fixtures/api/Cargo.toml --out target/surface/api --target x86_64-unknown-linux-gnu --target wasm32-wasip1 -- --profile dev --features doubled
    {{ exporter }} --manifest-path .work/moq-ffi-web/Cargo.toml --target wasm32-wasip1 --out target/surface/moq-web
    python3 -I surface/surface.py {{ flags }} target/surface/api surface/api
    python3 -I surface/surface.py {{ flags }} target/export/moq surface/moq
    # Its other bindings are moq's on wasm32, which no one ships.
    python3 -I surface/surface.py {{ flags }} target/surface/moq-web surface/moq-web web.d.ts

# Census the stand-in facade into target/census/moq-ffi.md, from the pinned moq revision or a checkout.
census checkout="": (standin checkout)
    {{ exporter }} --manifest-path .work/moq-ffi/Cargo.toml --census target/census

# Measure the binding benchmark (bench/ffi/README.md) from the pinned moq revision or a checkout, in the bench shell: nix develop .#bench. Its tables go to target/bench/report.md.
bench checkout="": mbx-shim mir-sysroot (bench-build checkout) rn-bench bench-run

# Build the binding benchmark's programs: Rust's floor, C, C++, Kotlin, Python, Swift, Go, Dart, and C# through the export, TypeScript through the wasm32 stand-in's and through the Node binding's addon, and C through moq's hand-written rs/libmoq. React Native's, which builds Hermes, is rn-bench's, which `bench` runs after it, so `count`'s build of this builds no Hermes.
bench-build checkout="": (moq-export checkout) (moq-web checkout) ts-program node-bench hooks
    #!/usr/bin/env bash
    set -euo pipefail
    [ -n "${LIBCLANG_PATH:-}" ] || { echo "LIBCLANG_PATH is unset: run this in the bench shell, nix develop .#bench" >&2; exit 1; }
    src="{{ checkout }}"
    [ -n "$src" ] || src=.work/moq
    out=target/export/moq
    hooks=$PWD/target/hooks
    # The exporter bench-run times, built as a consumer installs it.
    cargo build --locked --quiet --release
    # The floor: the stand-in's API called from Rust, resolved as the export is, its cases
    # counted through swole's harness at this checkout's own flake.lock pin, so a compare's
    # base builds with its own harness while both sides count under the shell's one runner.
    rm -rf target/bench-rust
    mkdir -p target/bench-rust
    root=$(dirname "$PWD")
    swole=$(jq -r '.nodes[.nodes.root.inputs.swole].locked | "github:\(.owner)/\(.repo)/\(.rev)?narHash=\(.narHash | @uri)"' "$root/flake.lock")
    swole=$(nix flake metadata --json "$swole" | jq -r .path)/crates/swole
    printf '[package]\nname = "bench"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n\n[[bin]]\nname = "bench"\npath = "%s"\n\n[dependencies]\nlibc = "0.2"\nmoq = { package = "moq-ffi", path = "%s" }\nswole = { path = "%s" }\n\n[workspace]\n' "$PWD/moq/bench/export.rs" "$PWD/.work/moq-ffi" "$swole" > target/bench-rust/Cargo.toml
    cp .work/moq-ffi/Cargo.lock target/bench-rust/Cargo.lock
    # The program's own flag, so moq builds as bench-run's export does: its path relative to
    # the repository, as the harness names a benchmark by.
    cargo rustc --quiet --release --manifest-path target/bench-rust/Cargo.toml -- "--remap-path-prefix=$root/="
    # libmoq's header is written to its build script's output directory.
    moqc=$(cd "$src" && cargo build --locked --quiet --release --package libmoq --message-format=json \
        | jq -r 'select(.reason == "build-script-executed" and (.package_id | contains("libmoq#"))) | .out_dir')
    cc -O2 -std=c11 -Wall -Wextra -Werror -I "$out/include" -I "$hooks" moq/bench/export.c "$out/target/release/libmoq.a" "$hooks/libhooks.a" -lpthread -ldl -lm -o target/bench-export
    cc -O2 -std=c11 -Wall -Wextra -Werror -I "$moqc/include" -I "$hooks" moq/bench/moq-c.c "$src/target/release/libmoq.a" "$hooks/libhooks.a" -lpthread -ldl -lm -o target/bench-moq-c
    c++ -O2 -std=c++17 -Wall -Wextra -Werror -I "$out/include" -I "$hooks" moq/bench/export.cpp "$out/target/release/libmoq.a" "$hooks/libhooks.a" -lpthread -ldl -lm -o target/bench-export-cpp
    {{ quote(just_executable()) }} go-module bench-go moq/bench/export.go
    # The include path goes in CGO_CPPFLAGS, so cgo keeps its default -O2 -g in CGO_CFLAGS;
    # the runtime's #cgo line links moq.
    export CGO_CPPFLAGS="-I$hooks" CGO_LDFLAGS="$hooks/libhooks.a" GOFLAGS=-buildvcs=false
    (cd target/bench-go && go build -o bench .)
    {{ quote(just_executable()) }} dart-program bench-dart moq/bench/export.dart
    {{ quote(just_executable()) }} csharp exe target/bench-csharp/bench.dll "$out/csharp/moq.cs" moq/bench/export.cs
    rm -rf target/bench-kt
    # moq's Kotlin outgrows the 512 MiB heap kotlinc's launcher defaults to.
    JAVA_OPTS="-Xmx2g -Xms128M" kotlinc -Werror -cp "$KOTLINX_COROUTINES" "$out/kotlin/moq.kt" "$out/kotlin/FastNative.kt" moq/bench/export.kt -d target/bench-kt
    {{ quote(just_executable()) }} swift-module -O
    swiftc -O -warnings-as-errors $({{ quote(just_executable()) }} swift-target 15) -I target/swift -I target/swift-collections/build -I "$out/swift" -I "$hooks" moq/bench/export.swift target/swift/libMoq.a -L target/swift-collections/build -lBasicContainers -lInternalCollectionsUtilities -lSpanPreview "$out/target/release/libmoq.a" "$hooks/libhooks.a" -lpthread -ldl -lm -o target/bench-export-swift

# Measure the binding benchmark's Kotlin rows (bench/ffi/README.md) on HotSpot here and, shrunk by R8 as an app is, on ART on the Android device adb reaches, from the pinned moq revision or a checkout, in the Android shell (nix develop .#android) with ANDROID_HOME and ANDROID_NDK_HOME set. Its tables go to target/bench-android/report.md.
bench-android rounds="3" checkout="":
    #!/usr/bin/env bash
    set -euo pipefail
    sdk=${ANDROID_HOME:?ANDROID_HOME names the Android SDK}
    adb=$sdk/platform-tools/adb
    newest() { find "$1" -mindepth 1 -maxdepth 1 | sort -V | tail -n 1; }
    abi=$("$adb" shell getprop ro.product.cpu.abi | tr -d '\r')
    case "$abi" in
        arm64-v8a) target=aarch64-linux-android ;;
        x86_64) target=x86_64-linux-android ;;
        *) echo "bench-android: the Android shell's toolchain has no target for the device's ABI $abi" >&2; exit 1 ;;
    esac
    # The export merges the device's API, so its Kotlin and libraries serve both; the API
    # stays staged in target/moq-api, as moq-api leaves it.
    {{ quote(just_executable()) }} moq-api "$target" {{ quote(checkout) }}
    {{ quote(just_executable()) }} moq-write {{ quote(checkout) }}
    out=target/export/moq
    dir=target/bench-android
    rm -rf "$dir"
    mkdir -p "$dir/dex"
    cargo build --locked --quiet --release --manifest-path "$out/Cargo.toml" --features kotlin
    cargo ndk --target "$abi" --platform 24 --output-dir "$dir/lib" build --locked --quiet --release --manifest-path "$out/Cargo.toml" --features kotlin
    # One jar for both VMs, the Kotlin standard library inside, as R8 reads an app's.
    JAVA_OPTS="-Xmx2g -Xms128M" kotlinc -Werror -cp "$KOTLINX_COROUTINES" "$out/kotlin/moq.kt" "$out/kotlin/FastNative.kt" moq/bench/export.kt -include-runtime -d "$dir/bench.jar"
    (cd "$dir" && jar xf "$KOTLINX_COROUTINES" META-INF/com.android.tools/r8/coroutines.pro)
    # HotSpot's CPU clock, which ART's run never reaches, is not in Android's library.
    printf '%s\n' '-keep class ExportKt { public static void main(java.lang.String[]); }' '-dontwarn com.sun.management.**' '-dontwarn java.lang.management.**' '-dontwarn org.jetbrains.annotations.**' > "$dir/app.pro"
    java -cp "$(newest "$sdk/build-tools")/lib/d8.jar" com.android.tools.r8.R8 --release --min-api 24 --lib "$(newest "$sdk/platforms")/android.jar" \
        --pg-conf "$out/kotlin/moq.pro" --pg-conf "$dir/META-INF/com.android.tools/r8/coroutines.pro" --pg-conf "$dir/app.pro" \
        --output "$dir/dex" "$dir/bench.jar" "$KOTLINX_COROUTINES"
    device=/data/local/tmp/rust2-bench
    "$adb" shell "rm -rf $device && mkdir -p $device/dalvik-cache"
    "$adb" push --sync "$dir/dex/classes.dex" "$dir/lib/$abi/libmoq.so" "$device" > /dev/null
    # As bench-run does: each program's lines prefixed by its language and round, and
    # suffixed by the host's load average over the run.
    raw=$dir/raw.tsv
    : > "$raw"
    load() {
        if [ "{{ os() }}" = macos ]; then
            sysctl -n vm.loadavg | awk '{ print $2 }'
        else
            awk '{ print $1 }' /proc/loadavg
        fi
    }
    run() {
        local lang=$1 before after
        shift
        before=$(load)
        "$@" | tr -d '\r' > "$dir/run.tsv"
        after=$(load)
        awk -v lang="$lang" -v round="$r" -v loadavg="$(echo "$before $after" | awk '{ print ($1 + $2) / 2 }')" -F '\t' \
            'NF == 3 { print lang "\t" round "\t" $1 "\t" $2 "\t" $3 "\t" loadavg; next } { print "bench-android: " lang ": unexpected line: " $0 > "/dev/stderr"; exit 1 }' \
            "$dir/run.tsv" >> "$raw"
    }
    for r in $(seq {{ rounds }}); do
        run kotlin java -Djava.library.path="$out/target/release" -cp "$dir/bench.jar:$KOTLINX_COROUTINES" ExportKt
        # dalvikvm interprets on Android 9 unless told to JIT, as an app's runtime does.
        run kotlin-art "$adb" shell "ANDROID_DATA=$device dalvikvm -Xusejit:true -Djava.library.path=$device -cp $device/classes.dex ExportKt"
    done
    {
        printf '## Kotlin on HotSpot and ART\n\nART: Android %s (API %s), %s, %s cores.\n\n' \
            "$("$adb" shell getprop ro.build.version.release | tr -d '\r')" "$("$adb" shell getprop ro.build.version.sdk | tr -d '\r')" "$abi" "$("$adb" shell grep -c ^processor /proc/cpuinfo | tr -d '\r')"
        python3 -I ../bench/ffi/report.py "$raw"
    } > "$dir/report.md"
    cat "$dir/report.md"

# Build moq/bench/hooks.c over the bench shell's Valgrind into target/hooks: a static library the compiled programs link, a shared one with the JNI functions that Kotlin, Python, and Dart load, the addon Node loads, and a module map Swift imports it by.
[private]
hooks:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -n "${RUST2_VALGRIND_INCLUDE:-}" ] || { echo "RUST2_VALGRIND_INCLUDE is unset: run this in the bench shell, nix develop .#bench" >&2; exit 1; }
    dir=target/hooks
    rm -rf "$dir"
    mkdir -p "$dir"
    flags=(-O2 -fPIC -std=c11 -Wall -Wextra -Werror -isystem "$RUST2_VALGRIND_INCLUDE")
    cc "${flags[@]}" -c moq/bench/hooks.c -o "$dir/hooks.o"
    ar rcs "$dir/libhooks.a" "$dir/hooks.o"
    cc "${flags[@]}" -shared -DHOOKS_JNI -isystem "${JAVA_HOME:?}/include" -isystem "$JAVA_HOME/include/linux" moq/bench/hooks.c -o "$dir/libhooks.so"
    node=$(dirname "$(dirname "$(realpath "$(command -v node)")")")/include/node
    cc "${flags[@]}" -shared -isystem "$node" -I moq/bench moq/bench/hooks-node.c "$dir/hooks.o" -o "$dir/hooks.node"
    cp moq/bench/hooks.h "$dir/"
    printf 'module Hooks {\n    header "hooks.h"\n    export *\n}\n' > "$dir/module.modulemap"

# Fail unless cargo builds through mbx's Cargo shim, which bench-run times the warm export through, before anything builds: run `mbx setup` once, and the dev shell finds it.
[private]
mbx-shim:
    @[ -n "${RUST2_CARGO_SHIM:-}" ] || { echo "no mbx Cargo shim: run mbx setup once, then reenter the dev shell" >&2; exit 1; }

# Fail unless the dev shell's MIR sysroot is set, which bench-run's web rows measure the export over and report.py names, before anything builds.
[private]
mir-sysroot:
    @[ -n "${RUST2_TS_SYSROOT:-}" ] || { echo "RUST2_TS_SYSROOT is unset or empty: run this in the dev shell" >&2; exit 1; }

# Run what bench-build and rn-bench built: each program `rounds` times into target/bench/raw.tsv, and the export, native and web, cold and warm through mbx, and its crate's build, beside moq's, each round into target/bench/build.tsv, with the 1-minute load average over each run, and their medians and the export's sizes into target/bench/report.md.
bench-run rounds="3": mbx-shim mir-sysroot
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    mkdir -p target/bench
    raw=target/bench/raw.tsv
    : > "$raw"
    # Each program prints a case, its wall time, and its CPU time a line; this prefixes its
    # language and round, and suffixes the load average over the run, the mean of the
    # 1-minute averages before and after it.
    load() {
        if [ "{{ os() }}" = macos ]; then
            sysctl -n vm.loadavg | awk '{ print $2 }'
        else
            awk '{ print $1 }' /proc/loadavg
        fi
    }
    run() {
        local lang=$1 before after
        before=$(load)
        {{ quote(just_executable()) }} bench-program "$lang" > target/bench/run.tsv
        after=$(load)
        awk -v lang="$lang" -v round="$r" -v loadavg="$(echo "$before $after" | awk '{ print ($1 + $2) / 2 }')" -F '\t' \
            'NF == 3 { print lang "\t" round "\t" $1 "\t" $2 "\t" $3 "\t" loadavg; next } { print "bench: " lang ": unexpected line: " $0 > "/dev/stderr"; exit 1 }' \
            target/bench/run.tsv >> "$raw"
    }
    # The export, native and web, and the generated crate's release build, each beside moq's
    # own of the same crates, from an emptied target and without a compiler cache, so nothing
    # is served cached; and each export again warm, through mbx: a step, its round, wall and
    # CPU seconds, peak RSS in bytes, and the load average.
    builds=target/bench/build.tsv
    : > "$builds"
    scratch=$PWD/target/bench/scratch
    sysroot=$(rustc --print sysroot)
    if [ "{{ os() }}" = macos ]; then libpath=DYLD_LIBRARY_PATH; else libpath=LD_LIBRARY_PATH; fi
    # Without mbx's Cargo shim, whose compiler cache an emptied target does not empty.
    uncached=(-u RUSTC_WRAPPER -u CARGO PATH="$(echo "$PATH" | tr : '\n' | grep -vxF "$RUST2_CARGO_SHIM" | paste -sd: -)")
    # Through it, into a store of the round's and export's own and no remote, which only the
    # export before the warm one fills, as an earlier CI run or another checkout would.
    cached=(MBX_REMOTE_MODE=write-only MBX_REMOTE_TRUST_WRITES=false)
    # Its store's objects are read-only.
    wipe() {
        if [ -d "$scratch" ]; then chmod -R u+w "$scratch"; fi
        rm -rf "$scratch"
    }
    # The step, `uncached` or the store under the scratch directory to cache through, and the
    # command, run from an emptied target; a step named `-` records nothing.
    measure() {
        local step=$1 before after via
        if [ "$2" = uncached ]; then via=("${uncached[@]}"); else via=("${cached[@]}" MBX_CACHE_DIR="$scratch/$2"); fi
        shift 2
        rm -rf "$scratch/target"
        before=$(load)
        line=$(env "${via[@]}" CARGO_TARGET_DIR="$scratch/target" python3 -I ../bench/ffi/measure.py "$@")
        after=$(load)
        [ "$step" = - ] || printf '%s\t%s\t%s\t%s\n' "$step" "$r" "$line" "$(echo "$before $after" | awk '{ print ($1 + $2) / 2 }')" >> "$builds"
    }
    build() {
        wipe
        local ffi=(env "$libpath=$sysroot/lib" target/release/rust2-ffi)
        local native=(--manifest-path .work/moq-ffi/Cargo.toml --out "$scratch/moq")
        local web=(--manifest-path .work/moq-ffi-web/Cargo.toml --target wasm32-wasip1 --out "$scratch/moq-web")
        # Each export writes into an emptied output too, as the cold one does.
        for step in export:uncached -:mbx-native export-warm:mbx-native; do
            rm -rf "$scratch/moq"
            measure "${step%:*}" "${step#*:}" "${ffi[@]}" "${native[@]}"
        done
        for step in web:uncached -:mbx-web web-warm:mbx-web; do
            rm -rf "$scratch/moq-web"
            measure "${step%:*}" "${step#*:}" "${ffi[@]}" "${web[@]}"
        done
        measure check uncached cargo check --quiet --release --lib --manifest-path .work/moq-ffi/Cargo.toml
        measure generated uncached cargo build --locked --quiet --release --manifest-path "$scratch/moq/Cargo.toml" --features kotlin,dart,node
        measure moq uncached cargo build --quiet --release --lib --manifest-path .work/moq-ffi/Cargo.toml
        wipe
    }
    for r in $(seq {{ rounds }}); do
        build
        for lang in {{ bench_langs }}; do
            run "$lang"
        done
    done
    python3 -I ../bench/ffi/report.py "$raw" "$builds" "$out" target/export/moq-web target/bench-ts/export.ts > target/bench/report.md
    cat target/bench/report.md

# Count each case of count_langs' programs in instructions with swole, from the bench shell, building them first: `just ffi count run --out metrics.json` for Kixel Quest's metrics.json, `just ffi count compare main` for each case's change from a commit; a path it takes is relative to ffi/. The Valgrind workflow's run.
[positional-arguments]
count *args:
    #!/usr/bin/env bash
    set -euo pipefail
    # The programs' switch to one round a case.
    export RUST2_COUNT=1
    # The programs' options follow these, so only a subcommand that counts takes them.
    case "${1-}" in
        run | compare) ;;
        *) echo "count: run or compare, then swole's options" >&2; exit 1 ;;
    esac
    for arg; do
        # swole takes every arg after -- as cargo's, which would swallow the programs,
        # and the programs are this recipe's to name.
        case "$arg" in
            --) echo "count: the programs take no cargo args" >&2; exit 1 ;;
            --build | --build=* | --program | --program=*) echo "count: $arg is this recipe's own" >&2; exit 1 ;;
        esac
    done
    just=$(printf %q {{ quote(just_executable()) }})
    programs=()
    for lang in {{ count_langs }}; do
        programs+=(--program "$just bench-program $lang")
    done
    swole "$@" --build "$just bench-build" "${programs[@]}"

# Run what bench-build or rn-bench built for one of bench_langs.
[private]
bench-program lang:
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    hooks=$PWD/target/hooks/libhooks.so
    wasm=target/export/moq-web/target/wasm32-wasip1/release/moq.wasm
    lang={{ lang }}
    case "$lang" in
        rust) exec target/bench-rust/target/release/bench ;;
        c) exec target/bench-export ;;
        cpp) exec target/bench-export-cpp ;;
        moq-c) exec target/bench-moq-c ;;
        kotlin) exec kotlin -Djava.library.path="$out/target/release:$PWD/target/hooks" -cp "target/bench-kt:$KOTLINX_COROUTINES" ExportKt ;;
        python) PYTHONPATH="$out/python" exec python3 -P moq/bench/export.py "$hooks" ;;
        swift) exec target/bench-export-swift ;;
        go) exec target/bench-go/bench ;;
        dart) exec dart target/bench-dart/main.dill "$hooks" ;;
        csharp) LD_LIBRARY_PATH="$out/target/release" DYLD_LIBRARY_PATH="$out/target/release" exec dotnet target/bench-csharp/bench.dll "$hooks" ;;
        ts-node)
            # Counted, V8 compiles, tiers the module up, and collects on this thread alone, as
            # its allocations schedule rather than time, and export.ts collects before each
            # case and gives the module a clock that moves only as it is read.
            flags=()
            [ -z "${RUST2_COUNT:-}" ] || flags=(--expose-gc --predictable --predictable-gc-schedule --single-threaded --wasm-sync-tier-up)
            exec node ${flags[@]+"${flags[@]}"} target/bench-ts/export.ts "$wasm" "$PWD/target/hooks/hooks.node" ;;
        ts-addon) exec node target/bench-node/main.ts ;;
        ts-chromium | ts-firefox) exec bun target/bench-ts/browser.ts "${lang#ts-}" "$wasm" "target/bench-browser/${lang#ts-}" ;;
        react-native) exec target/bench-rn/host target/bench-rn/bundle.js ;;
        *) echo "bench-program: no language {{ lang }}" >&2; exit 1 ;;
    esac

# Export moq's crates' C ABI, build it, and run moq/moq.c, moq/moq.cpp, moq/moq.kt, moq/moq.py, moq/moq.swift, moq/moq.go, moq/moq.dart, moq/moq.cs, and moq/moq.ts against it, the last on Hermes and through Node's addon, and compile its C# for Unity, from the pinned moq revision or a checkout.
moq checkout="": (moq-cpp checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    read -ra native < target/moq-native
    cc -std=c11 -pedantic -Wall -Wextra -Werror -I "$out/include" moq/moq.c "$out/target/release/libmoq.a" "${native[@]}" -o target/moq-test
    target/moq-test
    # The Kotlin, on the JVM, through the JNI functions the kotlin feature builds.
    rm -rf target/moq-kt
    JAVA_OPTS="-Xmx2g -Xms128M" kotlinc -Werror -cp "$KOTLINX_COROUTINES" "$out/kotlin/moq.kt" "$out/kotlin/FastNative.kt" moq/moq.kt -d target/moq-kt
    kotlin -Djava.library.path="$out/target/release" -cp "target/moq-kt:$KOTLINX_COROUTINES" MoqKt
    # The Python, through the CPython extension the python feature builds, and its types
    # through mypy and pyright, as `api_py_types` checks the api fixture's.
    PYTHONPATH="$out/python" python3 -P -X dev -W error moq/moq.py
    mypy --strict --python-version 3.11 --cache-dir target/mypy "$out/python/moq.py"
    pyright -p tests/pyright.json "$out/python/moq.py"
    {{ quote(just_executable()) }} moq-swift-run
    # The Go, through cgo, whose runtime's #cgo line links the library and what it needs besides.
    {{ quote(just_executable()) }} go-module moq-go moq/moq.go
    export GOFLAGS=-buildvcs=false
    (cd target/moq-go/export && go vet ./...)
    (cd target/moq-go && go vet ./... && go run .)
    # The Dart, through the shared library the dart feature builds.
    {{ quote(just_executable()) }} dart-program moq-dart moq/moq.dart
    dart --enable-asserts target/moq-dart/main.dill
    # The C#, run on .NET 10 through the shared library, and compiled as Unity does, against
    # .NET Standard 2.1.
    {{ quote(just_executable()) }} csharp exe target/moq-csharp/moq.dll "$out/csharp/moq.cs" moq/moq.cs
    LD_LIBRARY_PATH="$out/target/release" DYLD_LIBRARY_PATH="$out/target/release" dotnet target/moq-csharp/moq.dll
    {{ quote(just_executable()) }} csharp unity target/moq-csharp/unity.dll "$out/csharp/moq.cs" tests/unity.cs
    {{ quote(just_executable()) }} moq-react-native-run
    {{ quote(just_executable()) }} moq-node-run

