    tsc -p "$dir"

# Lay out target/bench-rn as export.ts over the React Native binding bench-build exported, on Hermes off a device: its modules React Native's, and its load the JSI module's, which takes no module, since the host installed it.
[private]
rn-bench:
    #!/usr/bin/env bash
    set -euo pipefail
    src=target/bench-rn-src
    mkdir -p "$src"
    sed -e 's|"\./web/|"./react-native/|' -e '/^const { readFileSync } = /d' \
        -e 's|^await api\.load(readFileSync(process\.argv\[2\]!));$|await api.load();|' moq/bench/export.ts > "$src/export.ts"
    grep -qx 'await api.load();' "$src/export.ts" || { echo "rn-bench: moq/bench/export.ts no longer loads its module as this rewrites it" >&2; exit 1; }
    {{ quote(just_executable()) }} rn-program bench-rn "$src/export.ts"

