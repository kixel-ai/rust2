# Lay out target/<dir> as the run of <script> over target/export/moq's Node binding and the addon moq-export left beside it, checked with tsc as a caller imports it.
[private]
node-program dir script:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=target/{{ dir }}
    rm -rf "$dir"
    mkdir -p "$dir"
    cp -r target/export/moq/node "$dir/node"
    cp {{ script }} "$dir/main.ts"
    printf '%s\n' '{"compilerOptions": {"strict": true, "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true,' \
        '"target": "es2024", "lib": ["es2024", "esnext.disposable", "dom"], "module": "esnext", "moduleResolution": "bundler",' \
        '"allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true, "skipLibCheck": true, "types": []},' \
        '"include": ["main.ts", "node/*.ts"], "exclude": ["node/*.d.ts"]}' > "$dir/tsconfig.json"
    tsc -p "$dir"

# Lay out target/<dir> as React Native's run of <script> on Hermes off a device, the flake's, which nix builds on first use: the script, checked with tsc over target/export/moq's React Native binding as a caller imports it, bundled into one script as Hermes runs it, its top-level await in an async function that exits as Node does, and tests/rn_host.cpp built over the binding's JSI module and moq's library.
[private]
rn-program dir script:
    #!/usr/bin/env bash
    set -euo pipefail
    hermes=$(nix build --no-link --print-out-paths ..#hermes)
    out=target/export/moq
    dir=target/{{ dir }}
    rm -rf "$dir"
    mkdir -p "$dir"
    cp -r "$out/react-native" "$dir/react-native"
    cp {{ script }} "$dir/main.ts"
    # What `load` reaches of React Native only where no host installed the module.
    printf '%s\n' 'export const TurboModuleRegistry = {' \
        '	getEnforcing<T>(name: string): T {' \
        '		throw new Error(`no TurboModule ${name} off React Native`);' \
        '	},' \
        '};' \
        'export type TurboModule = object;' > "$dir/react-native-stub.ts"
    printf '%s\n' '{"compilerOptions": {"strict": true, "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true,' \
        '"target": "es2024", "lib": ["es2024", "esnext.disposable", "dom"], "module": "esnext", "moduleResolution": "bundler",' \
        '"allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true, "skipLibCheck": true, "types": [],' \
        '"paths": {"react-native": ["./react-native-stub.ts"]}},' \
        '"include": ["main.ts", "react-native/*.ts"], "exclude": ["react-native/*.d.ts"]}' > "$dir/tsconfig.json"
    tsc -p "$dir"
    # Hermes takes a script, not modules, and lacks async generators. Sloppy, as React
    # Native's Babel preset compiles a module. Classes and their private fields stay as
    # Hermes runs them, close to the preset's loose properties: esbuild's lowering of a
    # private field into a WeakMap would cost every call more than either.
    (cd "$dir" && esbuild main.ts --bundle --format=esm --target=es2022 --supported:async-generator=false \
        --define:import.meta.url=undefined --alias:react-native=./react-native-stub.ts \
        --log-level=error --outfile=module.js)
    {
        printf '(async () => {\n'
        cat "$dir/module.js"
        # The host's `process.exit` throws `__exited` to stop the script, having exited already.
        printf '%s\n' '})().then(' \
            '	() => process.exit(0),' \
            '	(e) => {' \
            '		if (e instanceof Error && e.message === "__exited") return;' \
            '		process.stderr.write(`uncaught: ${e instanceof Error ? (e.stack ?? e.message) : String(e)}\n`);' \
            '		process.exit(1);' \
            '	},' \
            ');'
    } > "$dir/bundle.js"
    case "{{ os() }}" in
        macos) hermesvm=libhermesvm.dylib ;;
        *) hermesvm=libhermesvm.so ;;
    esac
    read -ra native < target/moq-native
    c++ -std=c++17 -O2 -Wall -Wextra -Werror -DRUST2_PREFIX_NS=rust2_moq -DRUST2_GLOBAL='"__rust2_moq"' -DRUST2_HEADER='"moq_jsi.h"' \
        -I "$out/include" -I "$dir/react-native/cpp" -isystem "$hermes/API" -isystem "$hermes/API/jsi" -isystem "$hermes/public" \
        -isystem "$hermes/include" -isystem "$hermes/build/lib/config" "$dir/react-native/cpp/moq_jsi.cpp" tests/rn_host.cpp \
        -o "$dir/host" "$hermes/build/lib/$hermesvm" "$hermes/build/jsi/libjsi.a" "$out/target/release/libmoq.a" "${native[@]}" \
        -Wl,-rpath,"$hermes/build/lib"

# Compile C# <sources> into <out> with Roslyn, warnings as errors and every doc comment well-formed: as .NET 10 compiles an `exe`, which `dotnet <out>` runs, or a `library`, or as Unity compiles one, at C# 9 against .NET Standard 2.1, the dev shell's NETSTANDARD_REF.
[private]
csharp kind out +sources:
    #!/usr/bin/env bash
    set -euo pipefail
    dotnet=$(dirname "$(realpath "$(command -v dotnet)")")
    csc=$(ls -d "$dotnet"/sdk/*/Roslyn/bincore/csc.dll | sort -V | tail -n 1)
    case "{{ kind }}" in
        exe | library)
            refs=$(ls -d "$dotnet"/packs/Microsoft.NETCore.App.Ref/*/ref/net10.0 | sort -V | tail -n 1)
            flags=(-target:{{ kind }} -warn:9999) ;;
        unity)
            refs=${NETSTANDARD_REF:?NETSTANDARD_REF is unset: run this in the dev shell}
            flags=(-target:library -langversion:9 -define:UNITY_5_3_OR_NEWER) ;;
        *) echo "csharp: no kind {{ kind }}" >&2; exit 1 ;;
    esac
    mkdir -p "$(dirname {{ quote(out) }})"
    references=()
    for dll in "$refs"/*.dll; do
        references+=("-r:$dll")
    done
    dotnet exec "$csc" -nologo -noconfig -nostdlib -unsafe -nullable:enable -warnaserror -optimize "${flags[@]}" \
        "${references[@]}" -out:{{ quote(out) }} -doc:{{ quote(without_extension(out) + ".xml") }} {{ sources }}
    if [ "{{ kind }}" = exe ]; then
        printf '%s\n' '{"runtimeOptions": {"tfm": "net10.0", "rollForward": "LatestPatch", "framework": {"name": "Microsoft.NETCore.App", "version": "10.0.0"}, "configProperties": {"System.Globalization.Invariant": true}}}' > "{{ without_extension(out) }}.runtimeconfig.json"
    fi

# Lay out target/<dir> as a Dart program whose main is <main>, importing the export's Dart as package:moq/moq.dart, whose native asset is the shared library, as a package's build hook would bundle it, which `dart compile` has no flag for; analyze it, and compile it into target/<dir>/main.dill.
[private]
dart-program dir main:
    #!/usr/bin/env bash
    set -euo pipefail
    out=$PWD/target/export/moq
    dir=target/{{ dir }}
    rm -rf "$dir"
    mkdir -p "$dir/.dart_tool"
    cp {{ main }} "$dir/main.dart"
    case "{{ os() }}" in
        macos) lib=libmoq.dylib ;;
        *) lib=libmoq.so ;;
    esac
    case "{{ arch() }}" in
        aarch64) arch=arm64 ;;
        *) arch=x64 ;;
    esac
    printf '{"configVersion": 2, "packages": [{"name": "moq", "rootUri": "file://%s/dart/", "packageUri": "lib/"}]}\n' "$out" > "$dir/.dart_tool/package_config.json"
    printf 'format-version: [1, 0, 0]\nnative-assets:\n  %s_%s:\n    "package:moq/moq.dart": [absolute, "%s"]\n' "{{ os() }}" "$arch" "$out/target/release/$lib" > "$dir/native_assets.yaml"
    dart analyze --fatal-infos "$dir"
    # pub.dev scores the library with the lints in tests/dart_lints.yaml, which the analyzer reads from the directory it analyzes.
    rm -rf "$dir-lint"
    mkdir "$dir-lint"
    cp "$out"/dart/lib/*.dart "$dir-lint"
    cp tests/dart_lints.yaml "$dir-lint/analysis_options.yaml"
    dart analyze --fatal-infos "$dir-lint"
    sdk=$(dirname "$(dirname "$(realpath "$(command -v dart)")")")
    "$sdk/bin/dartaotruntime" "$sdk/bin/snapshots/gen_kernel_aot.dart.snapshot" --platform "$sdk/lib/_internal/vm_platform_strong.dill" \
        --packages "$dir/.dart_tool/package_config.json" --native-assets "$dir/native_assets.yaml" -o "$dir/main.dill" "$dir/main.dart"

# Export moq's crates' C ABI as `just ffi moq` does, build it in debug, and run only moq/moq.c against it: `just ci`'s check that the export still serves moq, from the pinned moq revision or a checkout.
moq-c checkout="": (moq-write checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    # The lint moq-export denies, and the native libraries; only the static library, which
    # the C program links, with the glue of every language but Python's, whose symbols
    # would leave the link undefined.
    export RUSTFLAGS="-D recursion_depth_exceeding_limit --print=native-static-libs"
    cargo rustc --locked --quiet --manifest-path "$out/Cargo.toml" --lib --crate-type staticlib --features kotlin,dart 2>&1 | tee target/moq-c-build.log
    sed -n 's/^note: native-static-libs: //p' target/moq-c-build.log > target/moq-c-native
    read -ra native < target/moq-c-native
    link=(cc -std=c11 -pedantic -Wall -Wextra -Werror -I "$out/include" moq/moq.c "$out/target/debug/libmoq.a" "${native[@]}" -o target/moq-c-test)
    # The link reruns only when what it reads, the compiler, or the command changed, or its
    # program did: the stamp holds a hash of each, by content, since an export keeps mtimes.
    key() {
        { command -v cc; cc --version; printf '%s\n' "${link[@]}"; find "$out/include" -type f | LC_ALL=C sort | xargs sha256sum; sha256sum moq/moq.c "$out/target/debug/libmoq.a"; } | sha256sum
        sha256sum < target/moq-c-test
    }
    stamp=target/moq-c-test.stamp
    if ! [ -f target/moq-c-test ] || ! [ -f "$stamp" ] || [ "$(key)" != "$(cat "$stamp")" ]; then
        rm -f "$stamp"
        "${link[@]}"
        key > "$stamp"
    fi
    target/moq-c-test

# Export moq's crates' C ABI into target/export/moq, unbuilt, for the host and each target moq-api staged in target/moq-api.
[private]
moq-write checkout="": (standin checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    with=()
    for api in target/moq-api/*.json; do
        [ -e "$api" ] || continue
        # A staged API speaks for the sources it was checked from, which the export's must be.
        if ! cmp -s "${api%.json}.source" .work/moq-ffi/source; then
            echo "$api was staged from other moq sources than these: stage it again with just ffi moq-api, or delete it" >&2
            exit 1
        fi
        with+=(--with "$api")
    done
    # macOS's bash 3.2 reads an empty array as unset.
    {{ exporter }} --manifest-path .work/moq-ffi/Cargo.toml --out target/export/moq ${with[@]+"${with[@]}"}
    # Sources that changed while the export read them leave it matching neither version.
    if [ -f .work/moq-ffi/source ]; then
        before=$(cat .work/moq-ffi/source)
        {{ quote(just_executable()) }} standin {{ quote(checkout) }}
        if [ "$before" != "$(cat .work/moq-ffi/source)" ]; then
            rm -rf target/export/moq
            echo "moq's sources changed during the export: export again" >&2
            exit 1
        fi
    fi

# Stage moq's crates' API on one target into target/moq-api/<target>.json, from the pinned moq revision or a checkout, for `just ffi moq` and the recipes exporting as it does to merge into their binding. Run it on a host with the target's C toolchain, which moq's build scripts need even for a check: Android's is the NDK at ANDROID_NDK_HOME, in the Android shell (nix develop .#android).
moq-api target checkout="": (standin checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    target={{ target }}
    [ -f .work/moq-ffi/source ] || { echo "moq-api stages a git checkout of moq, whose revision names its sources" >&2; exit 1; }
    case "$target" in
        *-android*)
            # The NDK's compiler for the target, at API 24, the oldest moq's Android library
            # supports, as cargo-ndk sets it.
            case "{{ os() }}" in
                macos) host=darwin-x86_64 ;;
                *) host=linux-x86_64 ;;
            esac
            bin=${ANDROID_NDK_HOME:?ANDROID_NDK_HOME names the NDK}/toolchains/llvm/prebuilt/$host/bin
            clang=${target/armv7-/armv7a-}24-clang
            [ -x "$bin/$clang" ] || { echo "the NDK at $ANDROID_NDK_HOME has no $clang" >&2; exit 1; }
            var=${target//-/_}
            export "CC_$var=$bin/$clang" "AR_$var=$bin/llvm-ar"
            ;;
    esac
    mkdir -p target/moq-api
    rm -f "target/moq-api/$target.json" "target/moq-api/$target.source"
    before=$(cat .work/moq-ffi/source)
    {{ exporter }} --manifest-path .work/moq-ffi/Cargo.toml --target "$target" --api "target/moq-api/$target.json"
    # Sources that changed while the check read them leave the API matching neither version.
    {{ quote(just_executable()) }} standin {{ quote(checkout) }}
    if [ "$before" != "$(cat .work/moq-ffi/source)" ]; then
        rm -f "target/moq-api/$target.json"
        echo "moq's sources changed while staging the $target API: stage it again" >&2
        exit 1
    fi
    printf '%s\n' "$before" > "target/moq-api/$target.source"

# Export the wasm32 stand-in, moq's crates but moq-tokio, into target/export/moq-web for wasm32-wasip1, and build its module for the web binding.
[private]
moq-web checkout="": (standin checkout "web")
    {{ exporter }} --manifest-path .work/moq-ffi-web/Cargo.toml --target wasm32-wasip1 --out target/export/moq-web
    cargo build --locked --quiet --release --manifest-path target/export/moq-web/Cargo.toml --target wasm32-wasip1 --features web

# Export moq's crates' C ABI into target/export/moq and build it, with the libraries a program linking it needs besides in target/moq-native.
[private]
moq-export checkout="": (moq-write checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    # A later nightly makes this future-compat lint a hard error; fail on it in moq's crates
    # and the glue now, while the pin can still move. rustc prints the native libraries.
    export RUSTFLAGS="-D recursion_depth_exceeding_limit --print=native-static-libs"
    # The CPython extension's symbols would leave the C programs' links undefined, so it
    # builds apart, before the library they link, and moves beside the Python.
    case "{{ os() }}" in
        windows) lib=moq.dll ;;
        macos) lib=libmoq.dylib ;;
        *) lib=libmoq.so ;;
    esac
    cargo build --locked --quiet --release --manifest-path "$out/Cargo.toml" --features python
    # Cargo links the output to its build of the same features, which a rerun's last move
    # left here, and mv refuses to move a file onto itself.
    rm -f "$out/python/$lib"
    mv "$out/target/release/$lib" "$out/python/$lib"
    # The library the C programs link, and the shared one Kotlin, Dart, and Node load: the
    # Node-API addon resolves Node's functions as it registers, so it links no Node.
    cargo build --locked --quiet --release --manifest-path "$out/Cargo.toml" --features kotlin,dart,node 2>&1 | tee target/moq-build.log
    sed -n 's/^note: native-static-libs: //p' target/moq-build.log > target/moq-native
    # Beside the Node binding, where its `load` looks by default.
    cp "$out/target/release/$lib" "$out/node/moq.node"

# Write .work/moq-ffi, a facade re-exporting what moq-ffi ships from moq's crates, from the pinned moq revision or a checkout: the export follows its re-exports, as it will moq-ffi's remainder's. With `web`, .work/moq-ffi-web, the same without moq-tokio, which builds for no wasm32 target.
[private]
standin checkout="" web="":
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{ checkout }}"
    if [ -z "$src" ]; then
        {{ quote(just_executable()) }} moq-pin
        src=.work/moq
    fi
    # Absolute, but through any symlink as spelled: cargo hashes a path dependency outside
    # the workspace by its path, so a checkout reached through a link whose target moves,
    # such as one in an mbx store CI names afresh each run, would key moq's crates apart.
    src=$(cd "$src" && pwd -L)
    # Cargo on Windows reads a path as Windows writes it, not as Git Bash does.
    if [ "{{ os_family() }}" = windows ]; then
        src=$(cygpath -m "$src")
    fi
    dir=.work/moq-ffi
    # moq-ffi's dependencies, each with the features moq-ffi turns on, such as moq-mux's
    # async wrappers, read from its manifest.
    deps=(hang kio moq-mux moq-net moq-pattern moq-tokio)
    # rustls-native-certs, under moq-tokio, has no platform module on wasm32-wasip1.
    if [ -n "{{ web }}" ]; then
        dir=.work/moq-ffi-web
        deps=(hang kio moq-mux moq-net moq-pattern)
    fi
    ffi=$(cd "$src" && cargo metadata --format-version 1 --no-deps | jq -c '.packages[] | select(.name == "moq-ffi")')
    features=$(jq -c '[.dependencies[] | select(.kind == null) | {key: .name, value: .features}] | from_entries' <<< "$ffi")
    # moq-ffi's metadata, which a package of the stand-in states as moq-ffi's would, as
    # Maven Central requires its description, license, repository, and authors.
    meta=$(jq -r '[(.description // empty | "description = \(@json)"), (.license // empty | "license = \(@json)"),
        (.repository // empty | "repository = \(@json)"),
        (if (.authors | length) > 0 then "authors = [\(.authors | map(@json) | join(", "))]" else empty end)] | join("\n")' <<< "$ffi")
    mkdir -p "$dir/src"
    # Replace a file only when its content changes, so an unchanged stand-in, and the
    # export over it, stay fresh.
    update() {
        if cmp -s "$1" "$2"; then
            rm "$1"
        else
            mv "$1" "$2"
        fi
    }
    {
        printf '# Generated by just ffi standin, from %s.\n' "$src"
        printf '[package]\nname = "moq-ffi"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n'
        if [ -n "$meta" ]; then printf '%s\n' "$meta"; fi
        printf '\n'
        # The prefix of every C name.
        printf '[lib]\nname = "moq"\n\n[dependencies]\n'
        for name in "${deps[@]}"; do
            on=$(jq -r --arg name "$name" '.[$name] // [] | map(@json) | join(", ")' <<< "$features")
            printf '%s = { path = "%s/rs/%s", features = [%s] }\n' "$name" "$src" "$name" "$on"
        done
        printf '\n[workspace]\n'
        # moq's profiles, which the export carries as it would moq-ffi's own; the dev ones
        # tune test-only crates the stand-in does not resolve.
        awk '/^\[/ { keep = /^\[profile\./ && !/^\[profile\.dev[].]/ } keep' "$src/Cargo.toml"
    } > "$dir/Cargo.toml.new"
    update "$dir/Cargo.toml.new" "$dir/Cargo.toml"
    # What moq-ffi ships, re-exported: moq-net and moq-pattern at the root, beside the
    # waiter a driver's poll registers and the clock it polls at, and each other crate in a
    # module of its own, since several name an item alike, such as `Error`. moq-tokio's
    # session side only: the client, server, and origin a binding drives, with the configs
    # and the bind they take. Its QUIC driver, CLI, worker groups, and listener internals
    # stay out.
    cat > "$dir/src/lib.rs.new" <<'EOF'
    pub use kio::{Park, Waiter, WaiterList, clock, coop, log};
    pub use moq_net::*;
    pub use moq_pattern::*;

    pub mod hang {
        pub use ::hang::*;
    }

    pub mod mux {
        pub use ::moq_mux::*;
    }
    EOF
    [ -n "{{ web }}" ] || cat >> "$dir/src/lib.rs.new" <<'EOF'

    pub mod tokio {
        pub use ::moq_tokio::cli::Duration;
        pub use ::moq_tokio::{Backoff, Client, ConnectError, Connection, Error, Log, Restart, Server, Status, Transport, tls};

        pub mod client {
            pub use ::moq_tokio::client::Config;
        }

        pub mod connect {
            pub use ::moq_tokio::connect::Config;
        }

        pub mod connection {
            pub use ::moq_tokio::connection::Monitor;
        }

        pub mod listen {
            pub use ::moq_tokio::listen::{Bind, Config};
        }

        pub mod origin {
            pub use ::moq_tokio::origin::spawn;
        }

        pub mod quic {
            pub use ::moq_tokio::quic::Config;
        }

        pub mod server {
            pub use ::moq_tokio::server::{Config, Listener, Request};
        }
    }
    EOF
    update "$dir/src/lib.rs.new" "$dir/src/lib.rs"
    # moq's lockfile pins what moq's own builds use.
    cmp -s "$src/Cargo.lock" "$dir/Cargo.lock" || cp "$src/Cargo.lock" "$dir/Cargo.lock"
    # The sources' contents, which a staged API must share: the tree of every file git
    # does not ignore, untracked ones included, built in a scratch index so the
    # checkout's own stays untouched.
    rm -f "$dir/source"
    if git -C "$src" rev-parse --verify --quiet HEAD > /dev/null; then
        gitdir=$(git -C "$src" rev-parse --absolute-git-dir)
        index="$gitdir/rust2-source-index"
        if [ -f "$gitdir/index" ]; then cp "$gitdir/index" "$index"; else rm -f "$index"; fi
        GIT_INDEX_FILE="$index" git -C "$src" add -A
        GIT_INDEX_FILE="$index" git -C "$src" write-tree > "$dir/source"
        rm -f "$index"
        # And the stand-in's re-exports, which choose what of those sources the API holds.
        git hash-object "$dir/src/lib.rs" >> "$dir/source"
    fi

# Check out the pinned moq revision in .work/moq, apart from `just ts`'s so neither recipe touches the other's checkout, copying the objects its clone already has.
[private]
moq-pin:
    [ -d .work/moq/.git ] || git clone --quiet --filter=blob:none --reference-if-able ../ts/.work/moq --dissociate https://github.com/moq-dev/moq .work/moq
    GIT_NO_LAZY_FETCH=1 git -C .work/moq cat-file -e {{ moq_rev }}^{commit} 2> /dev/null || git -C .work/moq fetch --quiet origin {{ moq_rev }}
    git -C .work/moq checkout --quiet --detach {{ moq_rev }}
