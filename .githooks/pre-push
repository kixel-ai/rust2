#!/usr/bin/env bash
# Git runs this before a push: run `just ci` on the diff the push adds to origin/main,
# the same diff-scoped lint and tests the merge queue runs, so nothing else checks a
# change before the queue. The dev shell sets `core.hooksPath` to this directory.
# `git push --no-verify` skips it.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR to a hook of a linked worktree, which would point every `git -C`
# in the recipes, such as `just ts`'s clone of moq, at this repository instead of theirs.
unset GIT_DIR GIT_PREFIX GIT_WORK_TREE GIT_INDEX_FILE

# The tools and variables `just` needs come from the default dev shell, which a push from a
# plain shell, or from another shell such as `build-bench`, does not have. Its shellHook
# exports RUST2_DEV_SHELL, which the shells derived from it inherit.
if [[ -z "${RUST2_DEV_SHELL:-}" ]]; then
	exec nix develop --command "$0" "$@"
fi

# dispatch.sh checks the working tree, so a push is only checked if the tree is exactly
# what it pushes. Deleting a branch and pushing a tag change no code to check.
head=$(git rev-parse HEAD)
pushing=''
while read -r local_ref local_sha remote_ref _; do
	[[ "$remote_ref" == refs/heads/* && ! "$local_sha" =~ ^0+$ ]] || continue
	if [[ "$local_sha" != "$head" ]]; then
		# `quest start` pushes its claim, an empty commit on the default branch, without checking
		# it out; it adds no code to test, so it is not refused.
		# It builds on the upstream's live tip, which a stale local origin/main may not hold.
		if [[ "$(git rev-parse "$local_sha^{tree}")" == "$(git rev-parse "$local_sha^1^{tree}" 2>/dev/null)" ]]; then
			continue
		fi
		echo "pre-push: $local_ref is not the checked-out commit, so \`just ci\` would test other code; check it out, or push with --no-verify" >&2
		exit 1
	fi
	pushing=1
done
[[ -n "$pushing" ]] || exit 0

if [[ -n "$(git status --porcelain)" ]]; then
	echo "pre-push: the working tree has uncommitted changes, so \`just ci\` would test code the push lacks; commit or stash them, or push with --no-verify" >&2
	exit 1
fi

# Through `quest gate` when it is installed, so agents pushing in parallel queue for CPU
# like every other build; a nested gate runs at once, so `quest gate git push` is fine too.
if command -v quest >/dev/null; then
	exec quest gate just ci
fi
exec just ci
